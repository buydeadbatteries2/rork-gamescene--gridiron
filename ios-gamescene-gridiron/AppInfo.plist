	<!-- AdMob app-level identifier: ADMOB_APP_ID_VALUE is pinned directly in
	     the target build settings: production in Release, Google test in Debug.
	     Ad unit IDs ca-app-pub-.../... remain the separate keys below. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID_VALUE)</string>
	<key>AdMobBannerUnitID</key>
	<string>$(ADMOB_IOS_BANNER_ID)</string>
