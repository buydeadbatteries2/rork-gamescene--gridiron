	<key>AdMobRewardedUnitID</key>
	<string>$(ADMOB_IOS_REWARDED_ID)</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Your data is used to deliver ads that are more relevant to you. The game works fully without tracking.</string>
	<!-- Supabase configuration NO LONGER lives here: the client-safe values
	     (EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY) arrive
	     through the generated Config.swift at build time — see
	     SupabaseClientProvider. RLS remains the security boundary for the anon
	     key; the service-role key must NEVER appear in any client surface. -->
	<!-- Auth callback scheme for password-reset deep links. The redirect URL
	     (gamescene://auth-callback) must also be allowlisted in the Supabase
	     dashboard's Auth → URL Configuration — see the phase report. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gamescene.gridiron.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gamescene</string>
			</array>
		</dict>
	</array>
