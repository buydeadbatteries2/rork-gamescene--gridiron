	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- AdMob app-level identifier (ca-app-pub-...~...): RELEASE expands
	     $(ADMOB_APP_ID_VALUE) from the Rork ADMOB_IOS_APP_ID secret variable;
	     DEBUG defaults to Google's public test app ID. An unexpanded
	     placeholder is treated as "no ads" by AdMobService — never a crash.
	     (Ad unit IDs ca-app-pub-.../... are the separate keys below.) -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID_VALUE)</string>
	<key>AdMobBannerUnitID</key>
	<string>$(ADMOB_IOS_BANNER_ID)</string>
	<key>AdMobInterstitialUnitID</key>
	<string>$(ADMOB_IOS_INTERSTITIAL_ID)</string>
	<key>AdMobRewardedUnitID</key>
	<string>$(ADMOB_IOS_REWARDED_ID)</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Your data is used to deliver ads that are more relevant to you. The game works fully without tracking.</string>
	<!-- Supabase project configuration: expanded at build time from the Rork
	     secret variables SUPABASE_URL / SUPABASE_ANON_KEY via the same-named
	     build settings declared in project.pbxproj (the proven AdMob injection
	     path). The anon key is the public, RLS-protected key — the service-role
	     key must NEVER appear anywhere in the client. Empty or unexpanded values
	     mean "no Supabase": the app runs in guest/local mode. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<!-- Auth callback scheme for password-reset deep links. The redirect URL
	     (gamescene://auth-callback) must also be allowlisted in the Supabase
	     dashboard's Auth → URL Configuration — see the phase report. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gamescene.gridiron.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gamescene</string>
			</array>
		</dict>
	</array>
